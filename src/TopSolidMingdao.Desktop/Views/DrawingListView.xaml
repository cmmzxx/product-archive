<UserControl x:Class="TopSolidMingdao.Desktop.Views.DrawingListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="关联图纸" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                <TextBlock Text="{Binding SelectedProduct.Name, TargetNullValue=未选择产品, FallbackValue=未选择产品}"
                           ToolTip="{Binding SelectedProduct.Name}" TextTrimming="CharacterEllipsis"
                           FontSize="18" FontWeight="SemiBold" Margin="0,4,12,0" />
                <TextBlock Text="{Binding SelectedProduct.Code, TargetNullValue=—, FallbackValue=—}"
                           FontFamily="Consolas" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="刷新图纸" Command="{Binding RefreshDrawingsCommand}"
                    VerticalAlignment="Center" />
        </Grid>
        <ProgressBar Grid.Row="1" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}"
                     Visibility="{Binding IsLoadingDrawings, Converter={StaticResource BoolToVisibility}}" />
        <Grid Grid.Row="2">
            <!-- 这里只浏览元数据，没有图纸业务选择状态或 CAD 操作命令。 -->
            <DataGrid ItemsSource="{Binding Drawings}" RowHeight="52">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="图纸 / 文件名" Width="*" MinWidth="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" ToolTip="{Binding FileName}">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding FileName}" Foreground="{StaticResource MutedBrush}"
                                               FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="格式" Binding="{Binding Format}" Width="76" />
                    <DataGridTextColumn Header="大小" Binding="{Binding FileSize}" Width="88" />
                    <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="60" />
                    <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAt}" Width="142" />
                    <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{Binding DrawingPlaceholder}" Style="{StaticResource PlaceholderText}"
                       IsHitTestVisible="False"
                       Visibility="{Binding ShowDrawingPlaceholder, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
        <StackPanel Grid.Row="3" Margin="16,10">
            <TextBlock Text="{Binding DrawingError}" Style="{StaticResource ErrorText}" Margin="0,0,0,8"
                       Visibility="{Binding HasDrawingError, Converter={StaticResource BoolToVisibility}}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="加载更多 / 重试" Command="{Binding LoadMoreDrawingsCommand}"
                        Visibility="{Binding HasMoreDrawings, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding DrawingSummary}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    <TextBlock Text="{Binding TimeZoneLabel}" Foreground="{StaticResource MutedBrush}"
                               FontSize="10" Margin="0,4,8,0" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Grid>
</UserControl>
