<UserControl x:Class="TopSolidMingdao.Desktop.Views.ProductListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="产品" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,10" />
            <TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="按产品名称或编码搜索，按 Enter 立即查询"
                     AutomationProperties.Name="按产品名称或编码搜索" Margin="0,0,8,0">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Grid.Row="1" Grid.Column="1" Content="刷新" Command="{Binding RefreshProductsCommand}" />
        </Grid>
        <ProgressBar Grid.Row="1" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}"
                     Visibility="{Binding IsLoadingProducts, Converter={StaticResource BoolToVisibility}}" />
        <Grid Grid.Row="2">
            <DataGrid ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="产品编码" Binding="{Binding Code, TargetNullValue=—}" Width="112" />
                    <DataGridTextColumn Header="产品名称" Binding="{Binding Name}" Width="*" MinWidth="140" />
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{Binding ProductPlaceholder}" Style="{StaticResource PlaceholderText}"
                       IsHitTestVisible="False"
                       Visibility="{Binding ShowProductPlaceholder, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
        <StackPanel Grid.Row="3" Margin="14,10">
            <TextBlock Text="{Binding ProductError}" Style="{StaticResource ErrorText}" Margin="0,0,0,8"
                       Visibility="{Binding HasProductError, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding ProductSummary}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="上一页" Command="{Binding PreviousPageCommand}" Margin="0,0,8,0" />
                <Button Content="下一页" Command="{Binding NextPageCommand}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
