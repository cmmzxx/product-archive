<Window x:Class="TopSolidMingdao.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TopSolidMingdao.Desktop.Views"
        Style="{StaticResource {x:Type Window}}"
        Title="TopSolid 明道云集成助手"
        Width="1120" Height="660" MinWidth="980" MinHeight="580"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="88" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <Border Background="#233D4D" Padding="22,14">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="TOPSOLID × 明道云" Foreground="#C2D5E0"
                               FontFamily="Bahnschrift, Microsoft YaHei UI" FontSize="12" />
                    <TextBlock Text="产品图纸管理" Foreground="White" FontSize="23" Margin="0,4,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#345566" Padding="12,8" CornerRadius="3">
                    <TextBlock Text="{Binding EnvironmentLabel}" Foreground="#E4EFF5" FontSize="12" />
                </Border>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="18,18,18,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="350" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="3*" MinWidth="500" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="1" CornerRadius="3">
                <views:ProductListView />
            </Border>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="Transparent" />
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="3">
                <views:DrawingListView />
            </Border>
        </Grid>
        <TextBlock Grid.Row="2" Text="只读浏览 · 不下载文件，不修改 CAD 或明道云业务数据"
                   Foreground="{StaticResource MutedBrush}" FontSize="11"
                   Margin="20,0" VerticalAlignment="Center" />
    </Grid>
</Window>
